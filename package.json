{
  "name": "bigbanktest",
  "version": "1.0.0",
  "type": "module",
  "description": "API service for the Dragons of Mugloar game API, built on Express",
  "main": "app.js",
  "scripts": {
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "dev": "node --watch --env-file=.env src/app.ts",
    "start": "node --env-file=.env src/app.ts",
    "format": "prettier --write .",
    "swagger": "node scripts/generate.swagger.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KadriGbemi/dragonsofmugloar-service.git"
  },
  "author": "Gbemi Kadri",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/KadriGbemi/dragonsofmugloar-service/issues"
  },
  "homepage": "https://github.com/KadriGbemi/dragonsofmugloar-service#readme",
  "dependencies": {
    "axios": "^1.19.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "hpp": "^0.2.3",
    "mongodb": "^7.5.0",
    "morgan": "^1.11.0",
    "serverless-http": "^4.0.0",
    "swagger-autogen": "^2.23.7",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/hpp": "^0.2.7",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.1.2",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.10",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
